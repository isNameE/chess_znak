# SERVER configuration. Never commit credentials, certificates or databases.
DATABASE_URL=postgresql://arm_demo:CHANGE_ME@127.0.0.1:55432/arm_demo
ARM_HOST=127.0.0.1
ARM_PORT=8765
ARM_DEMO_MODE=true
# Required for network access. Use HTTPS reverse proxy; demo station credentials, not production RBAC.
ARM_ACCESS_USER=
ARM_ACCESS_PASSWORD=
# Only CRPT sandbox is supported by this demo. No production switch.
TRUE_API_ENABLED=false
TRUE_API_TOKEN=
TRUE_API_INN=
TRUE_API_TIMEOUT=15
# Fill only after reviewing current API docs for vegetable oils and packaging type.
TRUE_API_DOCUMENT_TYPE=
TRUE_API_PRODUCT_GROUP=
TRUE_API_PROFILE_REVIEWED=false
TRUE_API_DOCUMENT_PATH=/api/v3/lk/documents/create
TRUE_API_STATUS_PATH=/api/v4/true-api/doc/{document_id}/info
